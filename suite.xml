<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="RestfulBooker API Test Suite" verbose="1" parallel="none">
    <test thread-count="5" name="Restful Booker Tests">
        <groups>
            <run>
                <include name="auth"/>
                <include name="booking"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CreateTokenTest"/>
            <class name="tests.BookingTest"/>
        </classes>
    </test>

</suite>
